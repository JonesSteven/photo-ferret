# Copy to .env and fill in. Never commit .env.
TYPESAFE_API_KEY=
# Box questions need Jev 1.14 (jev-1.14.0 or the jev-preview alias).
JEV_MODEL=jev-1.14.0
PORT=3001

# The single admin account for /admin.
ADMIN_USER=
ADMIN_PASSWORD=
# Signs the admin session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Where the SQLite database, originals and derived images are stored.
DATA_DIR=./data
